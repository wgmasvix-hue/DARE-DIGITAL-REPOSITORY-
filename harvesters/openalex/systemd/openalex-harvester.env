# OpenAlex Harvester Environment Configuration
# This file is sourced by the systemd service

# Paths to configuration files
CONFIG_PATH=/etc/dare/harvester/config.json
TOPICS_PATH=/etc/dare/harvester/topics.json
STATE_PATH=/var/lib/dare/harvester/state.json
LOG_FILE=/var/log/dare/harvester/harvest.log

# OpenAlex API settings
OPENALEX_BASE_URL=https://api.openalex.org
OPENALEX_PER_PAGE=50
OPENALEX_RATE_LIMIT_DELAY=100

# DSpace settings
DSPACE_URL=https://dspace.dare.co.zw
DSPACE_API_KEY=your-api-key-here

# Feature flags
ENABLE_INCREMENTAL=true
ENABLE_DEDUPLICATION=true
ENABLE_ORCID_MATCHING=true
ENABLE_VECTOR_INDEXING=true

# Logging
LOG_LEVEL=info

# Retry settings
MAX_RETRIES=3
RETRY_DELAY=5

# Timeout settings (in seconds)
API_TIMEOUT=30
DSPACE_TIMEOUT=60
